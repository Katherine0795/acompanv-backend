                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registrar-con-rol",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registrar-con-rol"
              ]
            },
            "description": "Esperado: 200; en BD el password empieza con $2a$.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"prueba1\",\n  \"password\": \"abc123\",\n  \"idRol\": 2\n}"
