{
  "info": {
    "name": "ACOMPAV - DAW II",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas de la API. Requiere backend en localhost:9090 y la BD cargada con db/mercado_db.sql. Resultado esperado en la descripción de cada petición."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9090"
    },
    {
      "key": "hoy",
      "value": "2026-10-10"
    }
  ],
  "item": [
    {
      "name": "1. Login (BCrypt)",
      "item": [
        {
          "name": "1.1 Login correcto",
