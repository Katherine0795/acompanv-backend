    {
      "name": "3. Cobro (comprobante + pago + reporte)",
      "item": [
        {
          "name": "3.1 Comprobante que paga deudas 11 y 12 (puesto 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comprobante/registrar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comprobante",
                "registrar"
              ]
            },
            "description": "Esperado: 200, total 70.00. Luego GET /deudas: 11 y 12 en PAGADA con fechaPago.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero\": \"COMP-0011\",\n  \"tipo\": \"BOLETA\",\n  \"idPuesto\": 1,\n  \"idUsuario\": 1,\n  \"vuelto\": 0,\n  \"listaDetalle\": [\n    {\n      \"idDeuda\": 11\n    },\n    {\n      \"idDeuda\": 12\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "3.2 Repetir deuda 11",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comprobante/registrar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comprobante",
                "registrar"
              ]
            },
            "description": "Esperado: 409 'La deuda 11 ya está pagada'.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero\": \"COMP-0012\",\n  \"tipo\": \"BOLETA\",\n  \"idPuesto\": 1,\n  \"idUsuario\": 1,\n  \"vuelto\": 0,\n  \"listaDetalle\": [\n    {\n      \"idDeuda\": 11\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "3.3 Pago YAPE del comprobante 11",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pago/registrar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pago",
                "registrar"
              ]
            },
            "description": "Esperado: 200 (antes fallaba).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metodo\": \"YAPE\",\n  \"montoAcumulado\": 70.0,\n  \"detalles\": [\n    {\n      \"idComprobante\": 11\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "3.4 Pago insuficiente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pago/registrar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pago",
                "registrar"
              ]
            },
            "description": "Esperado: 400 (comprobante 1 ya pagado o monto insuficiente).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metodo\": \"EFECTIVO\",\n  \"montoAcumulado\": 10.0,\n  \"detalles\": [\n    {\n      \"idComprobante\": 1\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "3.5 Reporte de caja de hoy",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reporte/caja-rango?fechaInicio={{hoy}}&fechaFin={{hoy}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reporte",
                "caja-rango"
              ],
              "query": [
                {
                  "key": "fechaInicio",
                  "value": "{{hoy}}"
                },
                {
                  "key": "fechaFin",
                  "value": "{{hoy}}"
                }
              ]
            },
            "description": "Cambie la variable 'hoy'. Esperado: totalGeneral 70.00 y totalPorMetodoPago {YAPE: 70.00}."
          }
        },
        {
          "name": "3.6 Reporte abril 2026",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reporte/caja-mensual?anio=2026&mes=4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reporte",
                "caja-mensual"
              ],
              "query": [
                {
                  "key": "anio",
                  "value": "2026"
                },
                {
                  "key": "mes",
                  "value": "4"
                }
              ]
            },
            "description": "Esperado: total 690.00, desglose por EFECTIVO, PLIN, TRANSFERENCIA y YAPE (ya no por RECIBO)."
          }
        }
      ]
