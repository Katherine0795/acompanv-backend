            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Antes: UPDATE usuario SET estado=0 WHERE username='invitado1'. Esperado: 403 'Usuario inactivo'.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"invitado1\",\n  \"password\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "1.6 Registrar usuario con rol",
          "request": {
            "method": "POST",
            "header": [
              {
